{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yomu.yomuread.workers.dev/schema/extension.schema.json",
  "title": "Yomu extension descriptor",
  "description": "A declarative source adapter. Descriptors carry no executable code: they describe which URLs to request and which paths or selectors to read out of the answer. The Yomu Worker interprets them.",
  "type": "object",
  "required": ["id", "name", "version", "base", "hosts", "endpoints"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,48}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "version": { "type": "integer", "minimum": 1, "description": "Bump to publish an update. Yomu reloads a descriptor when this changes." },
    "language": { "type": "string" },
    "content": { "type": "array", "items": { "enum": ["manga", "manhwa", "manhua", "webtoon", "comic", "adult"] } },
    "base": { "type": "string", "format": "uri", "pattern": "^https://" },
    "hosts": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Every host this adapter may contact, for requests and for images. Enforced at runtime; wildcards-only entries are rejected." },
    "defaultCategory": { "enum": ["manga", "manhwa", "manhua", "webtoon", "comic", "adult"] },
    "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 20000 },
    "rateLimit": { "type": "object", "required": ["requests", "perSeconds"], "properties": { "requests": { "type": "integer", "minimum": 1 }, "perSeconds": { "type": "number", "minimum": 0.1 } } },
    "seriesIdFromChapter": {
      "description": "How to recover the series id from a chapter id, for the chapter manifest's sourceSeriesId. Omit when a chapter id says nothing about its series; the chapter id is then used as-is.",
      "type": "object", "minProperties": 1, "additionalProperties": false,
      "anyOf": [{ "required": ["regex"] }, { "required": ["queryParam"] }],
      "properties": { "queryParam": { "type": "string" }, "regex": { "type": "string" }, "group": { "type": "integer", "minimum": 0, "default": 1 } }
    },
    "headers": { "type": "object", "additionalProperties": { "type": "string" } },
    "endpoints": {
      "type": "object", "minProperties": 1, "additionalProperties": false,
      "properties": {
        "popular": { "$ref": "#/$defs/endpoint" }, "latest": { "$ref": "#/$defs/endpoint" }, "search": { "$ref": "#/$defs/endpoint" },
        "series": { "$ref": "#/$defs/endpoint" }, "chapters": { "$ref": "#/$defs/endpoint" }, "pages": { "$ref": "#/$defs/endpoint" }
      }
    }
  },
  "$defs": {
    "endpoint": {
      "type": "object", "required": ["path", "parse"],
      "properties": {
        "path": { "type": "string" }, "method": { "enum": ["GET", "POST"] },
        "query": { "type": "object", "additionalProperties": { "type": "string" } },
        "headers": { "type": "object", "additionalProperties": { "type": "string" } },
        "body": { "type": "string" }, "cacheTtl": { "type": "integer", "minimum": 0, "maximum": 86400 },
        "vars": { "type": "object", "additionalProperties": { "type": "object", "required": ["from"], "properties": { "from": { "type": "string" }, "plus": { "type": "number" }, "minus": { "type": "number" }, "times": { "type": "number" } } } },
        "before": { "type": "object" }, "parse": { "$ref": "#/$defs/parse" }
      }
    },
    "parse": {
      "type": "object", "required": ["type", "fields"],
      "properties": {
        "type": { "enum": ["json", "html"] },
        "extract": { "type": "object", "required": ["regex"], "properties": { "regex": { "type": "string" }, "group": { "type": "integer" } } },
        "list": { "type": "string" }, "limit": { "type": "integer", "minimum": 1, "maximum": 3000 },
        "filter": { "type": "array", "items": { "type": "object", "required": ["field"], "properties": { "field": { "type": "string" }, "contains": { "type": "string" }, "equals": { "type": "string" }, "matches": { "type": "string" }, "exists": { "type": "boolean" }, "notEmpty": { "type": "boolean" }, "caseInsensitive": { "type": "boolean" }, "negate": { "type": "boolean" } } } },
        "fields": { "type": "object", "additionalProperties": { "$ref": "#/$defs/field" } },
        "chapters": { "type": "object", "required": ["list", "fields"], "properties": { "list": { "type": "string" }, "fields": { "type": "object", "additionalProperties": { "$ref": "#/$defs/field" } } } }
      }
    },
    "field": {
      "type": "object",
      "properties": {
        "path": { "type": "string" }, "selector": { "type": "string" },
        "attr": { "type": "string", "description": "Read this attribute instead of text." },
        "attrs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "description": "Ordered attribute fallbacks; the first non-empty value wins. Useful for data-src/data-original/src lazy images." },
        "template": { "type": "string" }, "many": { "type": "boolean" }, "root": { "type": "boolean" },
        "transform": { "type": "array", "items": { "type": "object" } }
      }
    }
  }
}
