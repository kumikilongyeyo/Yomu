# Never commit credentials or the source engine's local state.
suwayomi/.env
.dev.vars
.dev.vars.*
suwayomi/.auth-header-b64
suwayomi/data/
suwayomi/*.log
suwayomi/fg.log

node_modules/
.wrangler/
dist/
.DS_Store
*.log

# Local Source Forge dependencies/state
tools/source-forge/node_modules/
tools/source-forge/.cache/

# Runtime gauntlet output. The report is a CI artifact; the committed evidence
# lives in docs/recovery/.
playwright-report/
test-results/

# Built by scripts/bundle-css.mjs during the release, from the stylesheets that
# are committed beside it. Generated at deploy time so the committed pages keep
# linking each file by name, which is what makes them readable and greppable.
dist-app/yomu-app-*.css
