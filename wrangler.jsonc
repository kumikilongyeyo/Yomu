{
  // One Worker serves both the app's files and its fetching.
  //
  // v5 routes through index-v5.ts, a thin Source Fabric wrapper around the
  // existing Worker. All legacy routes still delegate to worker/index.ts.
  //
  // Deploy with: npx wrangler deploy
  "name": "yomu",
  "main": "worker/index-v5.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist-app",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}
