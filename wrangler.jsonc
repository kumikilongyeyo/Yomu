{
  // One Worker serves both the app's files and its fetching.
  //
  // v5 routes through index-v5.ts, a thin Source Fabric wrapper around the
  // existing Worker. All legacy routes still delegate to worker/index.ts.
  //
  // Deploy with: npx wrangler deploy
  "name": "yomu",
  "main": "worker/index-v5.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist-app",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  // Yomu Sync's store. One entry per library code, plus short-lived pairing
  // codes and rate-limit counters that KV expires on its own.
  "kv_namespaces": [
    { "binding": "SYNC", "id": "a8c9b92d33444b45a5e1875b896c51b6" }
  ]
}
