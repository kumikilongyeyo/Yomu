{
  // One Worker serves both the app's files and its fetching.
  //
  // v9 wraps the v8 Source Fabric entrypoint with Browser Run capacity
  // diagnostics so Source Beast can wait on Cloudflare's real acquisition
  // window instead of guessing a fixed retry delay.
  //
  // Browser Run powers Source Beast's cloud-only human verification path. The
  // browser binding is authenticated by Cloudflare, so Yomu never needs a
  // localhost helper or a Browser Run API token in client-side code.
  //
  // Only routes that actually need Worker logic run Worker-first. Normal app
  // files, images, CSS and JS are served directly by Cloudflare Static Assets,
  // avoiding an unnecessary Worker invocation on every asset request.
  //
  // Deploy with: npx wrangler deploy
  "name": "yomu",
  "main": "worker/index-v9.ts",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": ["nodejs_compat"],
  "browser": {
    "binding": "BROWSER"
  },
  "assets": {
    "directory": "./dist-app",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/title/*",
      "/series/*",
      "/shelf/*",
      "/sources*",
      "/discover*",
      "/add-sources*"
    ]
  },
  // Runtime Broker compatibility service plus the user's Git-backed source
  // repositories. These are public read-only URLs; no GitHub write token lives
  // in the Worker. yomu-extensions writes itself from its own Actions token.
  "vars": {
    "SOURCE_RUNTIME_URL": "https://yomu-source-runtime.hatchable.site/api",
    "EXTENSIONS_REPO": "https://raw.githubusercontent.com/kumikilongyeyo/yomu-extensions/main",
    "FORGE_SOURCEPACK_URL": "https://raw.githubusercontent.com/kumikilongyeyo/yomu-extensions/main/sourcepack.json"
  },
  // Yomu Sync also stores short-lived Source Beast run/session metadata. Human
  // verification happens in Browser Run; the KV rows only keep opaque session
  // IDs and the browser state needed to reconnect the verified web source.
  "kv_namespaces": [
    { "binding": "SYNC", "id": "a8c9b92d33444b45a5e1875b896c51b6" }
  ]
}
