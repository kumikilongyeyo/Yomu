{
  // One Worker serves both the app's files and its fetching.
  //
  // v7.2 routes through index-v7.ts, which exposes Beast Adaptive as the
  // production Source Fabric surface while keeping the proven older wrappers
  // underneath as compatibility and rollback floors.
  //
  // `run_worker_first` is required so /sources reaches index-v7.ts before
  // Static Assets serves the SPA shell. That lets v7.2 inject the live Source
  // Fabric version badge into the real Sources screen on desktop and mobile.
  //
  // Deploy with: npx wrangler deploy
  "name": "yomu",
  "main": "worker/index-v7.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist-app",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  // Source Fabric v7.2 runtime broker. Hatchable exposes the broker under
  // /api, so the Worker appends /v1/resolve and /v1/source/* to this base.
  "vars": {
    "SOURCE_RUNTIME_URL": "https://yomu-source-runtime.hatchable.site/api"
  },
  // Yomu Sync's store. One entry per library code, plus short-lived pairing
  // codes and rate-limit counters that KV expires on its own.
  "kv_namespaces": [
    { "binding": "SYNC", "id": "a8c9b92d33444b45a5e1875b896c51b6" }
  ]
}
